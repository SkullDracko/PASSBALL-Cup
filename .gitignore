# PASSBALL Cup - Ignorar archivos innecesarios

# Archivos del sistema
Thumbs.db
.DS_Store
desktop.ini

# Archivos de configuración local
config/database_local.php

# Archivos temporales
*.tmp
*.log

# Uploads de usuarios (se generan en tiempo de ejecución)
# Solo se trackean los .gitkeep para preservar la estructura
uploads/**
!uploads/**/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo

.agents
.env

# Credenciales: nunca en el repositorio.
# crear_admin.php traia una contraseña en claro y los auth_*.txt guardaban
# notas de acceso. Se quitaron del tracking; si hacen falta, se generan
# fuera del repo o se administran con backend/api/administradores.
crear_admin.php
auth_*.txt

