# PASSBALL Cup - Ignorar archivos innecesarios

# Archivos del sistema
Thumbs.db
.DS_Store
desktop.ini

# Archivos de configuración local
config/database_local.php

# Archivos temporales
*.tmp
*.log

# Uploads de usuarios (se generan en tiempo de ejecución)
# Solo se trackean los .gitkeep para preservar la estructura
uploads/*
!uploads/*/
!uploads/*/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo
