# Configuración del backend (API REST).
# Copia este archivo a .env en la raíz del proyecto y ajusta los valores.
# .env NO se versiona: está en .gitignore.

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_NAME=passballcup
DB_USER=root
DB_PASS=

# --- Aplicación ---
# local | production
APP_ENV=local

# 1 = muestra errores detallados (traza PDO con DSN y nombre de la base).
# Dejar en 0 en cualquier entorno expuesto por HTTP: un 500 le revelaría la
# estructura de la base a un llamador anónimo.
APP_DEBUG=0
